# Copy this file to `.env` and fill in your values, then restart `npm run dev`.
# (Vite only exposes vars prefixed with VITE_ to the browser.)

# ── Backend (optional) ───────────────────────────────────────────────────────
# URL of the self-hosted Express server (video pipeline, FFmpeg merge, transcripts).
# VITE_AI_SERVER_URL=https://api.example.com

# ── DigitalOcean Spaces — durable storage for images & videos ────────────────
# Reuse the same Space/keys as the Projekt build (bucket `template-pictures-bucket`).
# Get Access/Secret from DO Dashboard → API → Spaces Keys.
# NOTE: these ship to the browser, so the Space should be dedicated to this app's
# media and the bucket CORS must allow your origins (PUT/GET/DELETE + the
# Authorization / x-amz-* / content-type headers).
VITE_DO_SPACES_KEY=your-do-spaces-access-key
VITE_DO_SPACES_SECRET=your-do-spaces-secret
VITE_DO_SPACES_REGION=fra1
VITE_DO_SPACES_BUCKET=template-pictures-bucket
# VITE_DO_SPACES_ENDPOINT=fra1.digitaloceanspaces.com   # optional, defaults to <region>.digitaloceanspaces.com
