# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id-here

# Server-side FFmpeg Video Merge (key-manager server URL)
# z.B. https://your-key-manager-domain.com
# Wenn nicht gesetzt, wird Browser-FFmpeg (WASM) als Fallback verwendet
VITE_MERGE_SERVER_URL=https://key-manager-wmmjk.ondigitalocean.app

# DigitalOcean Spaces für Projekt-Save/Load (Referenzbilder, generierte Bilder, Videos, Project-State)
# Hol dir Access/Secret aus dem DO Dashboard → API → Spaces Keys.
# Achtung: VITE_-Vars sind im Browser sichtbar — restricte den Key auf nur diesen Bucket.
VITE_DO_SPACES_KEY=your-do-spaces-access-key
VITE_DO_SPACES_SECRET=your-do-spaces-secret
VITE_DO_SPACES_REGION=fra1
VITE_DO_SPACES_BUCKET=template-pictures-bucket

# Diese Werte müssen in den DigitalOcean App Settings als Environment Variables gesetzt werden
# Niemals echte Keys hier eintragen oder ins Repository committen!
